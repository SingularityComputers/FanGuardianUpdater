<Window x:Class="FanGuardianWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="FanGuardian Updater" Width="540" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!--  SCROLLBAR  -->
        <Style x:Key="ScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="thumbBorder" Background="#555555" CornerRadius="3" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#888888"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="thumbBorder" Property="Background" Value="#00C8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Border Background="#1A1A1A" Width="10">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Border Background="#1A1A1A" Height="10">
                <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb Style="{StaticResource ScrollBarThumbStyle}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Border>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="MinWidth" Value="10"/>
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="MinHeight" Value="10"/>
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  TAB CONTROL  -->
        <Style TargetType="TabControl">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Tab header strip: black -->
                            <Border Grid.Row="0" Background="#0C0C0C" BorderBrush="#2A2A2A" BorderThickness="0,0,0,0">
                                <TabPanel IsItemsHost="True" Background="Transparent" Margin="6,5,6,0"/>
                            </Border>
                            <!-- Content area: light gray -->
                            <Border Grid.Row="1" Background="#007BA8" CornerRadius="8,8,0,0" ClipToBounds="True">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab Items -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Background" Value="#BBBBBB"/>
            <Setter Property="BorderBrush" Value="#AAAAAA"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,3,0"
                                CornerRadius="4,4,0,0">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Right"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#007BA8"/>
                                <Setter TargetName="tabBorder" Property="BorderBrush" Value="#005F82"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="tabBorder" Property="Background" Value="#55BBDD"/>
                                <Setter Property="Foreground" Value="White"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  COMBOBOX  -->
        <Style x:Key="ComboBoxToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="toggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="26"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="1" BorderBrush="#CCCCCC" BorderThickness="1,0,0,0" Margin="0,5,0,5">
                                    <TextBlock Text="▾" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="#555555" FontSize="11" FontFamily="Segoe UI"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="toggleBorder" Property="BorderBrush" Value="#007BA8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="toggleBorder" Property="BorderBrush" Value="#007BA8"/>
                                <Setter TargetName="toggleBorder" Property="CornerRadius" Value="4,4,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MaxDropDownHeight" Value="200"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="toggleButton"
                                          Style="{StaticResource ComboBoxToggleButtonStyle}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <ContentPresenter Margin="8,0,30,0"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"/>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="White"
                                        BorderBrush="#007BA8"
                                        BorderThickness="1"
                                        CornerRadius="0,0,4,4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBorder" Property="Background" Value="#007BA8"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  BUTTON  -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#CCCCCC"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#AAAAAA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#55BBDD"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#00C8FF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#BBBBBB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="Black"/>
                                <Setter Property="Background" Value="#999999"/>
                                <Setter TargetName="btnBorder" Property="BorderBrush" Value="#888888"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlashButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="BorderBrush" Value="#AAAAAA"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Bahnschrift SemiCondensed"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!--  MISC CONTROLS  -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,5,0">
                                <Ellipse x:Name="outerCircle" Stroke="White" StrokeThickness="1.5" Fill="Transparent"/>
                                <Ellipse x:Name="innerDot" Width="6" Height="6"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Fill="White" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="innerDot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0A0A0A"/>
            <Setter Property="Foreground" Value="#00CC66"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="CaretBrush" Value="#00C8FF"/>
        </Style>

        <Style TargetType="Hyperlink">
            <Setter Property="Foreground" Value="#00C8FF"/>
            <Setter Property="TextDecorations" Value="None"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>

    </Window.Resources>

    <Border BorderBrush="#007BA8" BorderThickness="1" CornerRadius="8,8,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--  TITLE BAR  -->
            <Border Grid.Row="0" Background="#0C0C0C" CornerRadius="7,7,0,0"
                    BorderBrush="#2A2A2A" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <!-- Logo: left -->
                    <Border Width="141" Height="16" Background="White"
                            HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Border.OpacityMask>
                            <ImageBrush ImageSource="/sc-logo.png" Stretch="Uniform"/>
                        </Border.OpacityMask>
                    </Border>

                    <!-- Title: right -->
                    <TextBlock Text="FanGuardian Updater"
                               Foreground="#CCCCCC"
                               FontFamily="Bahnschrift SemiCondensed"
                               FontWeight="SemiBold"
                               FontSize="14"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               Margin="0,0,44,0"/>

                    <!-- Close button -->
                    <Button x:Name="btnClose"
                            Content="✕"
                            HorizontalAlignment="Right"
                            Width="34" Height="34"
                            FontSize="14"
                            Click="btnClose_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="#555555"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="0,7,0,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#CC2222"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#991111"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!--  MAIN CONTENT  -->
            <Border Grid.Row="1" Background="#111111">
                <TabControl Margin="10,10,10,10">

                    <!--  CONTROLLER TAB  -->
                    <TabItem Header="FanGuardian Controller">
                        <Grid Background="Transparent" Margin="2,10,2,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="170"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                        TextWrapping="Wrap"
                                        Margin="2,0,2,5"
                                        FontFamily="Bahnschrift SemiCondensed"
                                        FontSize="13">
                                <Run Foreground="#CCCCCC" FontWeight="SemiBold">  Step 1 </Run>
                                <Run Foreground="#FFFFFF"> Disconnect FanGuardian from the PowerBoard (and from any power source)</Run>
                            </TextBlock>

                            <TextBlock Grid.Row="1"
                                       TextWrapping="Wrap"
                                       Margin="2,0,2,8"
                                       FontFamily="Bahnschrift SemiCondensed"
                                       FontSize="13">
                                <Run Foreground="#CCCCCC" FontWeight="SemiBold">  Step 2 </Run>
                                <Run Foreground="#FFFFFF"> Connect the controller panel to your computer using a USB Type-C cable</Run>
                            </TextBlock>

                            <Image Grid.Row="2"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,0,0,10" Source="/fg-c.png"/>

                            <Grid Grid.Row="3" Margin="2,0,2,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8"
                                       FontFamily="Bahnschrift SemiCondensed"
                                       FontSize="13">
                                    <Run Foreground="#CCCCCC" FontWeight="SemiBold"> Step 3 </Run>
                                    <Run Foreground="#FFFFFF"> Choose firmware</Run>
                                </TextBlock>

                                <RadioButton x:Name="ControllerOfficialRb" Grid.Row="1" Grid.Column="0"
                                             Content="Official firmware" IsChecked="True"
                                             GroupName="ControllerFirmware"
                                             Margin="0,0,12,6"
                                             FontFamily="Bahnschrift SemiCondensed"
                                             FontSize="13"
                                             Foreground="#FFFFFF"
                                             Checked="ControllerRadioButton_Checked"/>
                                <ComboBox x:Name="ControllerVersionComboBox" Grid.Row="1" Grid.Column="1"
                                          Width="130" HorizontalAlignment="Left" Margin="0,0,0,6"
                                          SelectionChanged="ControllerVersionComboBox_SelectionChanged"/>

                                <RadioButton x:Name="ControllerCustomRb" Grid.Row="2" Grid.Column="0"
                                             Content="Custom firmware"
                                             GroupName="ControllerFirmware"
                                             Margin="0,0,12,6"
                                             FontFamily="Bahnschrift SemiCondensed"
                                             FontSize="13"
                                             Foreground="#FFFFFF"
                                             Checked="ControllerRadioButton_Checked"/>
                                <Button x:Name="ControllerCustomFirmwareBrowseButton" Grid.Row="2" Grid.Column="1"
                                        Content="Browse..." Width="90" Height="26" HorizontalAlignment="Left"
                                        IsEnabled="False" Margin="0,0,0,6"
                                        Click="ControllerCustomFirmwareBrowseButton_Click"/>

                                <Label x:Name="ControllerFirmwareNameLabel" Grid.Row="3" Grid.ColumnSpan="2"
                                       Content="" Foreground="#FF6666" Padding="0,4,0,0"/>
                            </Grid>

                            <Grid Grid.Row="4" Margin="2,0,2,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                             FontFamily="Bahnschrift SemiCondensed"
                                             FontSize="13"
                                             Foreground="#FFFFFF">
                                    <Run Foreground="#CCCCCC" FontWeight="SemiBold"> Step 4 </Run>
                                    <Run Foreground="#FFFFFF"> Click the Flash button</Run>
                                </TextBlock>
                                <Button x:Name="ControllerFlashButton" Grid.Column="1"
                                        Content="FLASH" Width="90" Height="30"
                                        Style="{StaticResource FlashButtonStyle}"
                                        Click="ControllerFlashButton_Click"/>
                            </Grid>

                            <Button x:Name="ControllerLogToggle" Grid.Row="5"
                                    Content="▸  Log"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="6,4" Margin="0,6,0,2"
                                    Click="ControllerLogToggle_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#1C1C1C"/>
                                        <Setter Property="Foreground" Value="#888888"/>
                                        <Setter Property="BorderBrush" Value="#333333"/>
                                        <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#252525"/>
                                                            <Setter Property="Foreground" Value="#BBBBBB"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <TextBox x:Name="ControllerLogTextBox" Grid.Row="6"
                                     TextWrapping="Wrap" IsReadOnly="True" IsUndoEnabled="False"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0" Height="140" Margin="0,2,0,0"
                                     Visibility="Collapsed"/>
                        </Grid>
                    </TabItem>

                    <!--  DISPLAY TAB  -->
                    <TabItem Header="FanGuardian Display">
                        <Grid Background="Transparent" Margin="2,10,2,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="170"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       TextWrapping="Wrap"
                                       Margin="2,0,2,5"
                                       FontFamily="Bahnschrift SemiCondensed"
                                       FontSize="13">
                                <Run Foreground="#CCCCCC" FontWeight="SemiBold">  Step 1 </Run>
                                <Run Foreground="#FFFFFF"> Disconnect FanGuardian from the PowerBoard (and from any power source)</Run>
                            </TextBlock>

                            <TextBlock Grid.Row="1"
                                       TextWrapping="Wrap"
                                       Margin="2,0,2,8"
                                       FontFamily="Bahnschrift SemiCondensed"
                                       FontSize="13">
                                <Run Foreground="#CCCCCC" FontWeight="SemiBold">  Step 2 </Run>
                                <Run Foreground="#FFFFFF"> Connect the display panel to your computer using a USB Type-C cable</Run>
                            </TextBlock>

                            <Image Grid.Row="2"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,0,0,10" Source="/fg-d.png"/>

                            <Grid Grid.Row="3" Margin="2,0,2,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8"
                                           FontFamily="Bahnschrift SemiCondensed"
                                           FontSize="13">
                                    <Run Foreground="#CCCCCC" FontWeight="SemiBold"> Step 3 </Run>
                                    <Run Foreground="#FFFFFF"> Choose firmware</Run>
                                </TextBlock>

                                <RadioButton x:Name="DisplayOfficialRb" Grid.Row="1" Grid.Column="0"
                                             Content="Official firmware" IsChecked="True"
                                             GroupName="DisplayFirmware"
                                             Margin="0,0,12,6"
                                             FontFamily="Bahnschrift SemiCondensed"
                                             FontSize="13"
                                             Foreground="#FFFFFF"
                                             Checked="DisplayRadioButton_Checked"/>
                                <ComboBox x:Name="DisplayVersionComboBox" Grid.Row="1" Grid.Column="1"
                                          Width="130" HorizontalAlignment="Left" Margin="0,0,0,6"
                                          SelectionChanged="DisplayVersionComboBox_SelectionChanged"/>

                                <RadioButton x:Name="DisplayCustomRb" Grid.Row="2" Grid.Column="0"
                                             Content="Custom firmware"
                                             GroupName="DisplayFirmware"
                                             Margin="0,0,12,6"
                                             FontFamily="Bahnschrift SemiCondensed"
                                             FontSize="13"
                                             Foreground="#FFFFFF"
                                             Checked="DisplayRadioButton_Checked"/>
                                <Button x:Name="DisplayCustomFirmwareBrowseButton" Grid.Row="2" Grid.Column="1"
                                        Content="Browse..." Width="90" Height="26" HorizontalAlignment="Left"
                                        IsEnabled="False" Margin="0,0,0,6"
                                        Click="DisplayCustomFirmwareBrowseButton_Click"/>

                                <Label x:Name="DisplayFirmwareNameLabel" Grid.Row="3" Grid.ColumnSpan="2"
                                       Content="" Foreground="#FF6666" Padding="0,4,0,0"/>
                            </Grid>

                            <Grid Grid.Row="4" Margin="2,0,2,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           FontFamily="Bahnschrift SemiCondensed"
                                           FontSize="13"
                                           Foreground="#FFFFFF">
                                    <Run Foreground="#CCCCCC" FontWeight="SemiBold"> Step 4 </Run>
                                    <Run Foreground="#FFFFFF"> Click the Flash button</Run>
                                </TextBlock>
                                <Button x:Name="DisplayFlashButton" Grid.Column="1"
                                        Content="FLASH" Width="90" Height="30"
                                        Style="{StaticResource FlashButtonStyle}"
                                        Click="DisplayFlashButton_Click"/>
                            </Grid>

                            <Button x:Name="DisplayLogToggle" Grid.Row="5"
                                    Content="▸  Log"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    Padding="6,4" Margin="0,6,0,2"
                                    Click="DisplayLogToggle_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="#1C1C1C"/>
                                        <Setter Property="Foreground" Value="#888888"/>
                                        <Setter Property="BorderBrush" Value="#333333"/>
                                        <Setter Property="BorderThickness" Value="0,1,0,1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="FontFamily" Value="Segoe UI"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#252525"/>
                                                            <Setter Property="Foreground" Value="#BBBBBB"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <TextBox x:Name="DisplayLogTextBox" Grid.Row="6"
                                     TextWrapping="Wrap" IsReadOnly="True" IsUndoEnabled="False"
                                     VerticalScrollBarVisibility="Auto"
                                     BorderThickness="0" Height="140" Margin="0,2,0,0"
                                     Visibility="Collapsed"/>
                        </Grid>
                    </TabItem>

                    <!--  ABOUT TAB  -->
                    <TabItem Header="About">
                        <ScrollViewer Background="Transparent" Padding="6,10,6,10">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Foreground="#CCCCCC"
                                           FontFamily="Bahnschrift SemiCondensed"
                                           FontSize="13" Margin="0,0,0,6">BOSSA</TextBlock>
                                <TextBlock Foreground="#FFFFFF" FontFamily="Bahnschrift SemiCondensed"
                                           FontSize="13"
                                           TextWrapping="Wrap" Margin="0,0,0,4" LineHeight="20">
                                    This program uses the BOSSA CLI binary to flash the FanGuardian controller.
                                    Released under the BSD license:
                                </TextBlock>
                                <TextBlock FontFamily="Bahnschrift SemiCondensed"
                                           FontSize="13"
                                           TextWrapping="Wrap" Margin="0,0,0,2">
                                    <Hyperlink NavigateUri="https://raw.githubusercontent.com/shumatech/BOSSA/refs/heads/master/LICENSE"
                                               RequestNavigate="Hyperlink_RequestNavigate">
                                        https://raw.githubusercontent.com/shumatech/BOSSA/.../LICENSE
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock FontFamily="Bahnschrift SemiCondensed"
                                           FontSize="13"
                                           TextWrapping="Wrap" Margin="0,0,0,24">
                                    Source: <Hyperlink NavigateUri="https://github.com/shumatech/BOSSA"
                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                        https://github.com/shumatech/BOSSA
                                    </Hyperlink>
                                </TextBlock>

                                <TextBlock FontWeight="SemiBold" Foreground="#CCCCCC"
                                           FontFamily="Bahnschrift SemiCondensed"
                                           FontSize="13" Margin="0,0,0,6">esptool</TextBlock>
                                <TextBlock Foreground="#FFFFFF" FontFamily="Bahnschrift SemiCondensed"
                                           FontSize="13"
                                           TextWrapping="Wrap" Margin="0,0,0,4" LineHeight="20">
                                    This program uses the esptool CLI binary to flash the FanGuardian display.
                                    Released under the GNU license:
                                </TextBlock>
                                <TextBlock FontFamily="Bahnschrift SemiCondensed"
                                           FontSize="13"
                                           TextWrapping="Wrap" Margin="0,0,0,2">
                                    <Hyperlink NavigateUri="https://github.com/espressif/esptool/blob/master/LICENSE"
                                               RequestNavigate="Hyperlink_RequestNavigate">
                                        https://github.com/espressif/esptool/.../LICENSE
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock FontFamily="Bahnschrift SemiCondensed"
                                           FontSize="13"
                                           TextWrapping="Wrap">
                                    Source: <Hyperlink NavigateUri="https://github.com/espressif/esptool"
                                                       RequestNavigate="Hyperlink_RequestNavigate">
                                        https://github.com/espressif/esptool
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </Border>
        </Grid>
    </Border>
</Window>
